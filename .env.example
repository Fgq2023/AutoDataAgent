# AutoDataAgent configuration (copy to .env and fill in as needed)

# Optional: enable the LLM planner. Without a key, the system runs fully
# offline in deterministic mock mode.
# OPENAI_API_KEY=sk-...

# Optional: any OpenAI-compatible endpoint (e.g. a local or regional gateway).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model used by the LLM planner.
# OPENAI_MODEL=gpt-4o-mini

# OpenCode Go subscription (use a key from the subscribed workspace):
# OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENAI_MODEL=deepseek-v4.1-flash
